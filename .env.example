# MindMap v1 runs entirely in the browser — no server credentials are needed yet.
#
# These are placeholders for v2 (cloud canvas library) and v3 (in-app AI).
# Nothing in the current codebase reads them.

# Supabase — v2. The service-role key is server-only and must never be
# prefixed with NEXT_PUBLIC_, or Next.js will ship it to the browser bundle.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — v3. Server-only, read by a route handler, never by the client.
# ANTHROPIC_API_KEY=
