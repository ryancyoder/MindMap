# Cloud canvas library (optional).
#
# With these unset the app runs exactly as before: local-first, everything on
# the device, and the Maps sheet simply says cloud sync isn't set up. Setting
# them turns on the "In the cloud" section and lets agents read and write maps.
#
# Deliberately NOT prefixed with NEXT_PUBLIC_. The browser never talks to
# Supabase in this app — every read and write goes through a route handler —
# so no database key of any kind ships to the client bundle.
#
# The service-role key bypasses RLS. The mindmap_* tables have RLS enabled with
# no policies, which means this key is the only way in. Keep it out of the repo,
# out of logs, and out of anything client-side.

# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — v3, in-app AI operations. Server-only, read by a route handler.
# ANTHROPIC_API_KEY=
